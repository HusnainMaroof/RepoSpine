{
  "name": "repospine-cli",
  "version": "0.5.2",
  "description": "RepoSpine CLI — the local-first code-intelligence backbone for AI coding agents.",
  "author": "RepoSpine contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prof-bilal/RepoSpine.git"
  },
  "homepage": "https://github.com/Prof-bilal/RepoSpine",
  "bugs": {
    "url": "https://github.com/Prof-bilal/RepoSpine/issues"
  },
  "keywords": [
    "repospine",
    "codeatlas",
    "ai",
    "context",
    "code-search",
    "code-index",
    "mcp",
    "agent",
    "cli",
    "local-first"
  ],
  "type": "module",
  "bin": {
    "repospine": "./dist/index.js",
    "atlas": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node ../../scripts/copy-prebuilt-skills.mjs dist/skills/prebuilt",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "biome format --write ."
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@prof-bilal/atlas-mcp": "workspace:^",
    "@prof-bilal/atlas-sdk": "workspace:^"
  }
}
