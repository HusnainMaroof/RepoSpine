{
  "name": "@prof-bilal/atlas-proof",
  "version": "0.7.0-beta.1",
  "description": "Deterministic temporal change proof engine for CodeAtlas.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "biome format --write ."
  },
  "engines": { "node": ">=22.13.0" },
  "dependencies": {
    "@prof-bilal/atlas-core": "workspace:^",
    "@prof-bilal/atlas-shared": "workspace:^"
  },
  "license": "MIT",
  "publishConfig": { "access": "public", "tag": "beta" }
}
