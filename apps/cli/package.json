{
  "name": "repospine-cli",
  "version": "0.7.0-beta.1",
  "description": "RepoSpine CLI — local repository context that helps smaller AI models deliver stronger coding results.",
  "author": "RepoSpine contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prof-bilal/RepoSpine.git"
  },
  "homepage": "https://github.com/Prof-bilal/RepoSpine",
  "bugs": {
    "url": "https://github.com/Prof-bilal/RepoSpine/issues"
  },
  "keywords": [
    "repospine",
    "codeatlas",
    "ai",
    "context",
    "code-search",
    "code-index",
    "mcp",
    "agent",
    "cli",
    "local-first"
  ],
  "type": "module",
  "bin": {
    "repospine": "./dist/index.js",
    "atlas": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": ["dist"],
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "scripts": {
    "build": "tsup && node ../../scripts/copy-prebuilt-skills.mjs dist/skills/prebuilt",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "biome format --write ."
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.25.0",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@prof-bilal/atlas-mcp": "workspace:^",
    "@prof-bilal/atlas-sdk": "workspace:^"
  }
}
