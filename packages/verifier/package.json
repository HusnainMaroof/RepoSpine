{
  "name": "@prof-bilal/atlas-verifier",
  "version": "0.7.0-beta.1",
  "description": "Deterministic claim verification and baselines for CodeAtlas.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "biome format --write ."
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@prof-bilal/atlas-core": "workspace:^",
    "@prof-bilal/atlas-shared": "workspace:^",
    "@prof-bilal/atlas-storage": "workspace:^"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prof-bilal/RepoSpine.git",
    "directory": "packages/verifier"
  },
  "homepage": "https://github.com/Prof-bilal/RepoSpine",
  "bugs": {
    "url": "https://github.com/Prof-bilal/RepoSpine/issues"
  },
  "author": "CodeAtlas contributors"
}
