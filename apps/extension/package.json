{
  "name": "@prof-bilal/atlas-extension",
  "displayName": "RepoSpine",
  "private": true,
  "description": "Verified repository context for AI coding agents, right in the editor. Search symbols, explore dependencies, view summaries, and run repospine build/update.",
  "version": "0.0.0",
  "publisher": "codeatlas",
  "license": "MIT",
  "type": "module",
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.92.0"
  },
  "activationEvents": ["*"],
  "categories": ["Other"],
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@prof-bilal/atlas-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "^1.92.0"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeatlas",
          "title": "CodeAtlas",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "codeatlas": [
        {
          "id": "codeatlas.project",
          "name": "Project"
        },
        {
          "id": "codeatlas.symbols",
          "name": "Symbols"
        },
        {
          "id": "codeatlas.modules",
          "name": "Modules"
        },
        {
          "id": "codeatlas.summaries",
          "name": "Summaries"
        },
        {
          "id": "codeatlas.dependencies",
          "name": "Dependencies"
        }
      ]
    },
    "commands": [
      {
        "command": "codeatlas.openOverview",
        "title": "RepoSpine: Open Project Overview"
      },
      {
        "command": "codeatlas.searchSymbols",
        "title": "RepoSpine: Search Symbols"
      },
      {
        "command": "codeatlas.searchFiles",
        "title": "RepoSpine: Search Files"
      },
      {
        "command": "codeatlas.showModules",
        "title": "RepoSpine: Show Modules"
      },
      {
        "command": "codeatlas.showSummaries",
        "title": "RepoSpine: Show Summaries"
      },
      {
        "command": "codeatlas.showDependencies",
        "title": "RepoSpine: Show Dependency Graph"
      },
      {
        "command": "codeatlas.runBuild",
        "title": "RepoSpine: Run repospine build"
      },
      {
        "command": "codeatlas.runUpdate",
        "title": "RepoSpine: Run repospine update"
      },
      {
        "command": "codeatlas.refresh",
        "title": "RepoSpine: Refresh"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codeatlas.refresh",
          "when": "view == codeatlas.symbols || view == codeatlas.project",
          "group": "navigation"
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prof-bilal/CodeAtlas.git",
    "directory": "apps/extension"
  },
  "homepage": "https://github.com/Prof-bilal/CodeAtlas",
  "bugs": {
    "url": "https://github.com/Prof-bilal/CodeAtlas/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "RepoSpine contributors"
}
