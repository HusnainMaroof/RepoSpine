{
  "name": "@prof-bilal/atlas-mcp",
  "version": "0.7.0-beta.1",
  "description": "Model Context Protocol (MCP) server exposing CodeAtlas context to external AI tools.",
  "type": "module",
  "bin": {
    "codeatlas-mcp": "./dist/bin.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup && node ../../scripts/copy-prebuilt-skills.mjs dist/skills/prebuilt",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "biome format --write ."
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@prof-bilal/atlas-sdk": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.25.0",
    "ts-morph": "^28.0.0",
    "zod": "^3.23.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prof-bilal/CodeAtlas.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/Prof-bilal/CodeAtlas",
  "bugs": {
    "url": "https://github.com/Prof-bilal/CodeAtlas/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "author": "CodeAtlas contributors"
}
