{
  "name": "repospine",
  "version": "0.0.0",
  "private": true,
  "pnpm": {
    "overrides": {
      "brace-expansion@1": "1.1.21",
      "brace-expansion@5": "5.0.12",
      "fast-uri": "3.1.8",
      "hono": "4.13.13",
      "ip-address": "10.7.4",
      "proxy-addr": "2.0.8",
      "qs": "6.16.0"
    }
  },
  "description": "RepoSpine — precise repository context for frontier-level results from smaller AI models",
  "author": "RepoSpine contributors",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "release:smoke": "node scripts/release-smoke.mjs",
    "release:check": "pnpm build && pnpm check && pnpm release:smoke --online",
    "release:cli": "pnpm release:check && pnpm --filter repospine-cli publish --access public --tag beta",
    "release:plugin": "pnpm release:check && pnpm --filter @prof-bilal/atlas-chatgpt-plugin publish --access public --tag beta",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.9.0",
    "eslint": "^9.13.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.31.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "tsx": "^4.19.2",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vitest": "^2.1.4"
  }
}
